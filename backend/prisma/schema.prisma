// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// NOTE: To use SQLite instead of PostgreSQL, change:
// 1. datasource db provider to "sqlite"
// 2. datasource db url to "file:./dev.db"
// 3. Remove/comment out DATABASE_URL in .env or set it to "file:./dev.db"

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Todo {
  id        Int      @id @default(autoincrement())
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
