{
  "name": "d-english-backend",
  "version": "1.0.0",
  "description": "Backend API for D English IELTS Platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:init": "npx prisma migrate dev --name init",
